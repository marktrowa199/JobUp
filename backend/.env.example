APP_NAME=JobUp
ENVIRONMENT=development
# Set this only in the server-side backend environment.
DATABASE_URL=your_database_connection_string
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Add the private address of the Next.js server/reverse proxy in production.
TRUSTED_PROXY_IPS=["127.0.0.1","::1"]
# Optional for direct FastAPI job-search API use. The Next.js route reads
# SERPAPI_API_KEY from frontend/.env.local.
SERPAPI_API_KEY=
SESSION_COOKIE_NAME=jobup_session
SESSION_EXPIRY_DAYS=7
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_USE_TLS=true
